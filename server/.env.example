# --- Required -------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/college_voting
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
OTP_SECRET=change-me-to-a-different-long-random-string

# --- Email (Nodemailer). Leave SMTP_HOST empty in development to print emails/OTPs in the terminal.
# Gmail example: host smtp.gmail.com, port 587, and an App Password (needs 2-Step Verification).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="College Election <your-address@gmail.com>"

# --- Optional -------------------------------------------------------------
PORT=5000
COLLEGE_NAME=Your College
# Only needed if the React app is hosted on a different origin than this server
CLIENT_ORIGIN=
# Set to 1 when deployed behind a reverse proxy (Render, Nginx, etc.) so rate limits see real IPs
TRUST_PROXY=0
VOTE_OTP_MINUTES=5
NOMINATION_OTP_MINUTES=5
ADMIN_OTP_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
